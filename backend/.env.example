# ==============================================================================
# JnU Analyzer - Backend Environment Variables
# Copy this file to `.env` and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO CONFIGURATION
# ------------------------------------------------------------------------------
# Set to 'False' in production. Set to 'True' ONLY for local development.
DEBUG=False

# Django settings module:
# - 'config.settings.development' for local SQLite dev
# - 'config.settings.production' for live production deployment
DJANGO_SETTINGS_MODULE=config.settings.production

# REQUIRED IN PRODUCTION: A secure, randomly generated 50+ character string.
# Generate one using: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=generate-a-strong-random-50-character-secret-key-for-production

# Comma-separated list of valid host/domain names this app can serve.
# Example: "jnu-analyzer.onrender.com,api.yourdomain.com,localhost"
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# ------------------------------------------------------------------------------
# 2. CORS & CSRF CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated URLs allowed to make cross-origin requests to this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://jnu-analyzer.onrender.com,https://your-frontend.vercel.app

# Comma-separated URLs trusted for CSRF state-changing requests.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://jnu-analyzer.onrender.com,https://your-frontend.vercel.app

# ------------------------------------------------------------------------------
# 3. PRODUCTION HTTPS & COOKIE SECURITY
# ------------------------------------------------------------------------------
# Set to 'True' when deployed behind HTTPS / SSL reverse proxy (Render, Fly.io, Vercel, Cloudflare).
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Universal DATABASE_URL (standard for Render, Railway, Fly.io, Heroku, Neon, Supabase)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Option B: Explicit PostgreSQL credentials (used if USE_POSTGRES=True)
USE_POSTGRES=False
DB_NAME=result_analyzer_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Option C: Default SQLite (zero-config, stored in backend/db.sqlite3)
# Leave USE_POSTGRES=False and DATABASE_URL empty to use SQLite.

# ------------------------------------------------------------------------------
# 5. EPHEMERAL STORAGE & PRIVACY TTL
# ------------------------------------------------------------------------------
# Time-to-Live (TTL) in minutes before uploaded datasets are automatically purged.
SESSION_TTL_MINUTES=60

# Max upload payload size in Megabytes.
MAX_UPLOAD_SIZE_MB=25

# Ephemeral filesystem storage directory for temporary uploaded result sheet files.
UPLOAD_DIR=/tmp/result_analyzer/uploads
