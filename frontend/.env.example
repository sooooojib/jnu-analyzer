# ==============================================================================
# JnU Analyzer - Frontend Environment Variables
# ==============================================================================

# In local development with Vite dev server proxy:
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# Or leave empty to use relative '/api/v1' path:
VITE_API_BASE_URL=/api/v1

# In production with decoupled deployment (e.g. Vercel frontend + Render backend):
# VITE_API_BASE_URL=https://jnu-analyzer.onrender.com/api/v1
